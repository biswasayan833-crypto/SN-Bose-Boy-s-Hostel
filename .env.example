# Prof. S.N. Bose Boys Hostel Community - Environment Configuration Example

# Backend Server Configuration (.env in hostel-community/server/.env)
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sn_bose_hostel?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sn_bose_hostel

# Client URL for CORS
CLIENT_URL=http://localhost:5173

# Authentication Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Email Two-Factor Authentication (Optional: If empty, OTP codes are printed to server console)
EMAIL_USER=
EMAIL_PASS=
EMAIL_SERVICE=gmail

# Frontend Configuration (.env in hostel-community/client/.env)
VITE_API_BASE_URL=/api
VITE_APP_NAME="Prof. S.N. Bose Boys Hostel Community"
