# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# Replace with your MongoDB Atlas connection string or local URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sn_bose_hostel?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sn_bose_hostel

# Client URL for CORS (Allow production Vercel URL and local development; supports comma-separated URLs)
CLIENT_URL=https://your-frontend.vercel.app,http://localhost:5173

# Authentication Configuration
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Email Two-Factor Authentication Options
# Option 1: Brevo REST API over HTTPS (Port 443 - Recommended for Render Free Tier to bypass blocked SMTP ports 25/465/587)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME="Prof. S.N. Bose Boys Hostel"

# Option 2: Google Apps Script Webhook over HTTPS (Port 443)
EMAIL_WEBHOOK_URL=

# Option 3: Nodemailer SMTP (Note: Render Free Tier blocks outbound SMTP ports 25, 465, and 587)
EMAIL_USER=
EMAIL_PASS=
EMAIL_SERVICE=gmail
